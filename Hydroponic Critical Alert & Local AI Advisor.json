      "parameters": {
        "method": "POST",
        "url": "http://192.168.0.103:11434/api/generate",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"llama3.2:1b\",\n  \"prompt\": \"The hydroponic system status is CRITICAL. Live parameters: pH={{ $('Fetch Firebase Sensor Data').item.json.ph }}, TDS={{ $('Fetch Firebase Sensor Data').item.json.tds }} ppm, EC={{ $('Fetch Firebase Sensor Data').item.json.ec }} mS/cm, Water Temp={{ $('Fetch Firebase Sensor Data').item.json.water_temp }}°C, Humidity={{ $('Fetch Firebase Sensor Data').item.json.humidity }}%. Give 2-3 short, actionable bullet points explaining how the farmer should fix this immediately.\",\n  \"stream\": false,\n  \"options\": {\n    \"num_predict\": 100\n  }\n}",
        "options": {
          "timeout": 60000
        }
      },
